# Copy the values below into Vercel: Project Settings -> Environment Variables.
# Never commit a real .env file with actual secrets in it.

# Supabase project (Settings -> API in your Supabase dashboard).
# Server-only — used by /api routes, never sent to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Same project URL as above, plus the "anon" / "public" key (Settings -> API).
# Exposed to the browser on purpose — it's a public identifier, not a secret;
# Row Level Security on each table is what actually restricts access. These
# power customer accounts (sign up / log in / order history). Also make sure
# Email auth is enabled in Supabase: Authentication -> Providers -> Email.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay API keys (Settings -> API Keys in your Razorpay dashboard).
# Start with the "Test Mode" keys to verify everything end-to-end for free.
# RAZORPAY_KEY_SECRET is server-only and must never be exposed to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Same value as RAZORPAY_KEY_ID above, exposed to the browser (Vite only
# exposes variables prefixed with VITE_) so the frontend can open the
# Razorpay Checkout widget. This is safe to expose — it's a public key id,
# not a secret.
VITE_RAZORPAY_KEY_ID=
